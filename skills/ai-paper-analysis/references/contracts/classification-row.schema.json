{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AkihaTatsu/AI-Paper-Analysis-Skill-Codex/contracts/classification-row.schema.json",
  "title": "Classification CSV Row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "paper_id", "title", "authors_json", "publication_year",
    "venue", "doi", "arxiv_id", "canonical_url", "pdf_url", "local_pdf_path",
    "report_path", "code_repository_url", "code_commit", "taxonomy_id",
    "taxonomy_version", "category_id",
    "category_name", "subcategory_id", "subcategory_name",
    "classification_reason", "evidence_locator", "verification_status",
    "review_status", "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "paper_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "authors_json": {"type": "string"},
    "publication_year": {"type": "string", "pattern": "^$|^[0-9]{4}$"},
    "venue": {"type": "string"},
    "doi": {"type": "string"},
    "arxiv_id": {"type": "string"},
    "canonical_url": {"type": "string"},
    "pdf_url": {"type": "string"},
    "local_pdf_path": {"type": "string"},
    "report_path": {"type": "string"},
    "code_repository_url": {"type": "string"},
    "code_commit": {"type": "string"},
    "taxonomy_id": {"type": "string", "minLength": 1},
    "taxonomy_version": {"type": "string", "minLength": 1},
    "category_id": {"type": "string", "minLength": 1},
    "category_name": {"type": "string", "minLength": 1},
    "subcategory_id": {"type": "string", "minLength": 1},
    "subcategory_name": {"type": "string", "minLength": 1},
    "classification_reason": {"type": "string", "minLength": 1},
    "evidence_locator": {"type": "string", "minLength": 1},
    "verification_status": {"enum": ["verified", "partial", "failed", "conflict"]},
    "review_status": {"enum": ["proposed", "confirmed", "rejected"]},
    "notes": {"type": "string"}
  }
}

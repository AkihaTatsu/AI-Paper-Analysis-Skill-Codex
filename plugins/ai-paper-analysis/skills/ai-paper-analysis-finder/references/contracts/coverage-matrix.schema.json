{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AkihaTatsu/AI-Paper-Analysis-Skill-Codex/contracts/coverage-matrix.schema.json",
  "title": "Temporary report coverage matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_kind",
    "rows"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "report_kind": {
      "enum": [
        "paper",
        "category"
      ]
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "object_kind",
          "report_section",
          "required_locator_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "object_kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "report_section": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "report_anchor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "required_locator_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^apa-[a-z0-9][a-z0-9-]*$"
            }
          },
          "demonstration_kind": {
            "enum": [
              "formula",
              "flow"
            ]
          },
          "demonstration_target": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "dependentRequired": {
          "demonstration_kind": [
            "demonstration_target"
          ],
          "demonstration_target": [
            "demonstration_kind"
          ]
        }
      }
    }
  }
}

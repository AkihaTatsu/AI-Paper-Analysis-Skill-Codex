{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AkihaTatsu/AI-Paper-Analysis-Skill-Codex/contracts/report-review.schema.json",
  "title": "Completed content review attestation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "report_kind": {
      "enum": [
        "paper",
        "category"
      ]
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "publication_path": {
      "type": "string",
      "minLength": 1
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_sections": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 7
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_fidelity",
        "coverage",
        "terminology",
        "reasoning",
        "formulas_and_analogies",
        "experiments_and_relationships"
      ],
      "properties": {
        "source_fidelity": {
          "type": "boolean"
        },
        "coverage": {
          "type": "boolean"
        },
        "terminology": {
          "type": "boolean"
        },
        "reasoning": {
          "type": "boolean"
        },
        "formulas_and_analogies": {
          "type": "boolean"
        },
        "experiments_and_relationships": {
          "type": "boolean"
        }
      }
    },
    "content_status": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "style_exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "quote",
          "evidence",
          "reason"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "report_kind",
    "report_sha256",
    "publication_path",
    "policy_sha256",
    "sources",
    "reviewer",
    "reviewed_at",
    "reviewed_sections",
    "checks",
    "content_status",
    "limitations",
    "style_exceptions"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AkihaTatsu/AI-Paper-Analysis-Skill-Codex/contracts/review-issues.schema.json",
  "title": "Consolidated semantic review issues",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_kind", "baseline_sha256", "issues"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_kind": {"enum": ["paper", "category"]},
    "baseline_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "classification",
          "report_locator",
          "source_locator",
          "impact",
          "repair_condition",
          "obsolete_literals",
          "required_evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "classification": {"enum": ["deterministic", "semantic"]},
          "report_locator": {"type": "string", "minLength": 1, "maxLength": 1000},
          "source_locator": {"type": "string", "minLength": 1, "maxLength": 1000},
          "impact": {"type": "string", "minLength": 1, "maxLength": 2000},
          "repair_condition": {"type": "string", "minLength": 1, "maxLength": 3000},
          "obsolete_literals": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 1000}
          },
          "required_evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["locator_id", "report_section"],
              "properties": {
                "locator_id": {
                  "type": "string",
                  "pattern": "^apa-[a-z0-9][a-z0-9-]*$"
                },
                "report_section": {"type": "integer", "minimum": 1, "maximum": 7}
              }
            }
          },
          "automatic_patch": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["old_text", "new_text"],
                "properties": {
                  "old_text": {"type": "string", "minLength": 1, "maxLength": 50000},
                  "new_text": {"type": "string", "minLength": 1, "maxLength": 50000}
                }
              }
            ]
          }
        }
      }
    }
  }
}

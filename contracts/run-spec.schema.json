{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AkihaTatsu/AI-Paper-Analysis-Skill-Codex/contracts/run-spec.schema.json",
  "title": "AI Paper Analysis Run Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "approval_stage",
    "workflows",
    "target_root",
    "output_language",
    "subagents_authorized",
    "revision_mode",
    "question_tool_confirmed",
    "approved_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"},
    "approval_stage": {"enum": ["target_acquisition", "full_execution"]},
    "workflows": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["finder", "interpreter", "comparator"]}
    },
    "target_root": {"type": "string", "minLength": 1},
    "output_language": {"type": "string", "minLength": 2},
    "finder": {"$ref": "#/$defs/finder"},
    "interpreter": {"$ref": "#/$defs/interpreter"},
    "comparator": {"$ref": "#/$defs/comparator"},
    "subagents_authorized": {"type": "boolean"},
    "revision_mode": {"enum": ["none", "candidate_then_promote"]},
    "question_tool_confirmed": {"const": true},
    "approved_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"workflows": {"contains": {"const": "finder"}}}},
      "then": {"required": ["finder"]}
    },
    {
      "if": {"properties": {"workflows": {"contains": {"const": "interpreter"}}}},
      "then": {"required": ["interpreter"]}
    },
    {
      "if": {"properties": {"workflows": {"contains": {"const": "comparator"}}}},
      "then": {"required": ["comparator"]}
    }
  ],
  "$defs": {
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date_from", "date_to", "languages", "paper_types"],
      "properties": {
        "date_from": {"type": ["string", "null"], "format": "date"},
        "date_to": {"type": ["string", "null"], "format": "date"},
        "languages": {"type": "array", "items": {"type": "string"}},
        "paper_types": {"type": "array", "items": {"type": "string"}}
      }
    },
    "stop_policy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "target_accepted", "candidate_cap"],
          "properties": {
            "mode": {"const": "target_count"},
            "target_accepted": {"type": "integer", "minimum": 1},
            "candidate_cap": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "exhaustive_bounds_confirmed"],
          "properties": {
            "mode": {"const": "exhaustive"},
            "exhaustive_bounds_confirmed": {"const": true}
          }
        }
      ]
    },
    "network_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_host_concurrency", "timeout_seconds", "max_retries", "max_pdf_mib"],
      "properties": {
        "per_host_concurrency": {"type": "integer", "minimum": 1, "maximum": 8},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "max_retries": {"type": "integer", "minimum": 0},
        "max_pdf_mib": {"type": "integer", "minimum": 1}
      }
    },
    "finder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_topic",
        "inclusion_criteria",
        "exclusion_criteria",
        "bounds",
        "providers",
        "access_mode",
        "stop_policy",
        "classification_requested",
        "ocr",
        "keep_staging",
        "network_defaults",
        "credential_sources"
      ],
      "properties": {
        "research_topic": {"type": "string", "minLength": 1},
        "inclusion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "exclusion_criteria": {"type": "array", "items": {"type": "string"}},
        "bounds": {"$ref": "#/$defs/bounds"},
        "providers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "access_mode": {"enum": ["public_only", "public_and_authorized"]},
        "stop_policy": {"$ref": "#/$defs/stop_policy"},
        "classification_requested": {"type": "boolean"},
        "taxonomy_id": {"type": ["string", "null"]},
        "taxonomy_version": {"type": ["string", "null"]},
        "ocr": {"enum": ["disabled", "ask_if_needed", "enabled"]},
        "keep_staging": {"type": "boolean"},
        "staging_output_dir": {"type": ["string", "null"], "minLength": 1},
        "network_defaults": {"$ref": "#/$defs/network_defaults"},
        "credential_sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["environment", "browser_session", "sops_age"]}
        }
      }
    },
    "future_work_budget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {"mode": {"const": "none"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "target_per_direction", "candidate_cap_per_direction", "date_from", "date_to", "providers"],
          "properties": {
            "mode": {"const": "search"},
            "target_per_direction": {"type": "integer", "minimum": 1},
            "candidate_cap_per_direction": {"type": "integer", "minimum": 1},
            "date_from": {"type": ["string", "null"], "format": "date"},
            "date_to": {"type": ["string", "null"], "format": "date"},
            "providers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
          }
        }
      ]
    },
    "interpreter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_refs",
        "novelty_comparison_refs",
        "benchmark_source_refs",
        "future_work_budget",
        "analogy_scenario",
        "source_limitation_policy",
        "ocr"
      ],
      "properties": {
        "input_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "novelty_comparison_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "benchmark_source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "future_work_budget": {"$ref": "#/$defs/future_work_budget"},
        "analogy_scenario": {"type": "string", "minLength": 1},
        "source_limitation_policy": {"enum": ["target_characterization_only", "stop"]},
        "ocr": {"enum": ["disabled", "ask_if_needed", "enabled"]}
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_id", "category_id", "subcategory_id"],
      "properties": {
        "paper_id": {"type": "string", "minLength": 1},
        "category_id": {"type": "string", "minLength": 1},
        "subcategory_id": {"type": "string", "minLength": 1}
      }
    },
    "comparator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification_path",
        "taxonomy_path",
        "category_selection",
        "subcategory_assignments",
        "everyday_scenario"
      ],
      "properties": {
        "classification_path": {"type": "string", "minLength": 1},
        "taxonomy_path": {"type": "string", "minLength": 1},
        "category_selection": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "subcategory_assignments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assignment"}},
        "everyday_scenario": {"type": "string", "minLength": 1}
      }
    }
  }
}
